# Public browser configuration only. Never put passwords or service-account JSON in VITE_* variables.
VITE_FIREBASE_CONFIG=
# Runtime data must use the CRM Firebase project so Auth and shopCash are shared.

# Opt in only while the local Firebase emulators are running from CISapp.
VITE_USE_FIREBASE_EMULATORS=false
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
